<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_card_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/txtDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/orbitron_bold"
        android:text="@string/dialog_clear_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingMultiplier="1.2"
        android:text="@string/dialog_clear_message"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/dialogActionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogCancel"
            style="?android:attr/buttonStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dialog_button_neutral_dark"
            android:minWidth="84dp"
            android:paddingHorizontal="16dp"
            android:text="@string/dialog_cancel"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnDialogConfirm"
            style="?android:attr/buttonStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/dialog_button_danger_dark"
            android:minWidth="84dp"
            android:paddingHorizontal="16dp"
            android:text="@string/dialog_clear_confirm"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
