<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start">

            <TextView
                android:id="@+id/txtPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_bg"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="v1.0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circular_button_ripple"
            android:contentDescription="Settings"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_gear" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="always"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/manrope_bold"
                android:letterSpacing="-0.03"
                android:lineSpacingMultiplier="0.9"
                android:text="File&#10;Navigator"
                android:textSize="38sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/btnRunScript"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.6"
                android:text="Sort your downloads, instantly"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtHeaderTitle" />

            <ImageButton
                android:id="@+id/btnRunScript"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/circular_action_ripple"
                android:contentDescription="Run Script Now"
                android:padding="20dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_play"
                app:layout_constraintBottom_toBottomOf="@id/txtSubtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/txtHeaderTitle" />

            <Button
                android:id="@+id/btnEditRules"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/rounded_button_ripple_white"
                android:text="Edit"
                android:textSize="15sp"
                app:layout_constraintEnd_toStartOf="@id/btnViewLogs"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtSubtitle" />

            <Button
                android:id="@+id/btnViewLogs"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="36dp"
                android:background="@drawable/rounded_button_ripple"
                android:text="Logs"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnEditRules"
                app:layout_constraintTop_toBottomOf="@id/txtSubtitle" />

            <TextView
                android:id="@+id/lblEventLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Event Log (last 100 entries):"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnViewLogs" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLog"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/log_field_bg"
                android:clipToPadding="false"
                android:overScrollMode="always"
                android:padding="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblEventLog" />

            <LinearLayout
                android:id="@+id/rowLogButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:gravity="end"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rvLog"
                app:layout_constraintVertical_bias="0">

                <Button
                    android:id="@+id/btnRefreshLog"
                    style="?android:attr/buttonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/rounded_button_bg"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:minHeight="40dp"
                    android:paddingHorizontal="16dp"
                    android:text="Refresh"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnClearLog"
                    style="?android:attr/buttonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_button_bg"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:minHeight="40dp"
                    android:paddingHorizontal="16dp"
                    android:text="Clear"
                    android:textSize="14sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
