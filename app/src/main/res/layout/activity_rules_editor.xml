<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top App Bar / Header Row -->
    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circular_button_ripple"
            android:contentDescription="Back"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back_arrow" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:gravity="start|center_vertical">

            <TextView
                android:id="@+id/txtPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_bg"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="rules.conf"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Saved ✓"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Hero Header section matching MainActivity -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/heroHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/txtHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/orbitron_bold"
                android:lineSpacingMultiplier="0.95"
                android:text="Rules&#10;Editor"
                android:textSize="32sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/btnRunScript"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="16dp"
                android:alpha="0.6"
                android:text="Configure download sorting rules"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/btnRunScript"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtHeaderTitle" />

            <ImageButton
                android:id="@+id/btnRunScript"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/circular_action_ripple"
                android:contentDescription="Run Script Now"
                android:padding="16dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_play"
                app:layout_constraintBottom_toBottomOf="@id/txtSubtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/txtHeaderTitle" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Curved Input Section -->
        <LinearLayout
            android:id="@+id/editorCardContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/editor_card_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Top Mode Bar inside Editor -->
            <LinearLayout
                android:id="@+id/rowEditorTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/txtModePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/anta"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="📖 READ MODE • Tap to edit"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/txtRulesStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:fontFamily="@font/anta"
                    android:text="rules.conf"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Quick Snippet Chips Bar -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rowChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lblQuickInsert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:alpha="0.6"
                        android:text="Insert:"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipRule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/anta"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="+ [rule]"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/chipDest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/anta"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="+ dest"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/chipExt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/chip_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/anta"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="+ ext"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/chipScanDirs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/anta"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="+ scan_dirs"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <View
                android:id="@+id/editorDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.1"
                android:background="#FFFFFF" />

            <!-- The Code/Text Editor -->
            <EditText
                android:id="@+id/edit_rules"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/anta"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:lineSpacingMultiplier="1.25"
                android:paddingHorizontal="4dp"
                android:paddingVertical="4dp"
                android:scrollbars="vertical"
                android:textColor="#E0E0E0"
                android:textColorHint="#616161"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Rounded Bottom Action Buttons -->
        <LinearLayout
            android:id="@+id/rowBottomButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <Button
                android:id="@+id/button_pick_path"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_button_bg"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="Pick Path"
                android:textSize="14sp" />

            <Button
                android:id="@+id/button_reset"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="0.8"
                android:layout_marginStart="8dp"
                android:background="@drawable/rounded_button_bg"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="Reset"
                android:textSize="14sp" />

            <Button
                android:id="@+id/button_save"
                style="?android:attr/buttonStyle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.2"
                android:layout_marginStart="8dp"
                android:background="@drawable/rounded_button_ripple_white"
                android:text="Save"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
